# =============================================================================
# Vidya - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# Connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
# Direct connection for migrations (bypasses connection pooler)
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# --- Supabase ---
# Project URL (found in Supabase dashboard under Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Anon/public key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret"
# Application URL (used for auth redirects)
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Credentials from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Google Gemini AI ---
# API key from Google AI Studio
GEMINI_API_KEY="your-gemini-api-key"

# --- NVIDIA AI (Fallback Provider) ---
# API key from NVIDIA AI Foundation (https://build.nvidia.com)
# Used as automatic fallback when Gemini rate limits are hit
NVIDIA_API_KEY="your-nvidia-api-key"
# Optional: override the default model (default: z-ai/glm-5.2)
# NVIDIA_MODEL="z-ai/glm-5.2"

# --- Application ---
# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Node environment
NODE_ENV="development"
