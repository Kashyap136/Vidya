generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ProcessingStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  GENERATING_TOPICS
  TOPICS_CREATED
  GENERATING_PLAN
  PLAN_CREATED
  GENERATING_QUIZ
  QUIZ_CREATED
  COMPLETED
  FAILED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  createdBy   String?
  createdByUser   User?  @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedBy   String?
  updatedByUser   User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id])

  createdUsers        User[]             @relation("UserCreatedBy")
  updatedUsers        User[]             @relation("UserUpdatedBy")
  accounts            Account[]
  sessions            Session[]
  syllabi             Syllabus[]
  passwordResetTokens PasswordResetToken[]
  quizAttempts        QuizAttempt[]
  createdAccounts     Account[]          @relation("AccountCreatedBy")
  updatedAccounts     Account[]          @relation("AccountUpdatedBy")
  createdSyllabi      Syllabus[]         @relation("SyllabusCreatedBy")
  updatedSyllabi      Syllabus[]         @relation("SyllabusUpdatedBy")
  createdTopics       Topic[]            @relation("TopicCreatedBy")
  updatedTopics       Topic[]            @relation("TopicUpdatedBy")
  createdQuizAttempts QuizAttempt[]      @relation("QuizAttemptCreatedBy")
  updatedQuizAttempts QuizAttempt[]      @relation("QuizAttemptUpdatedBy")
  createdQuizzes      Quiz[]             @relation("QuizCreatedBy")
  updatedQuizzes      Quiz[]             @relation("QuizUpdatedBy")
  createdQuestions    QuizQuestion[]     @relation("QuizQuestionCreatedBy")
  updatedQuestions    QuizQuestion[]     @relation("QuizQuestionUpdatedBy")
  studyPlans          StudyPlan[]
  createdStudyPlans   StudyPlan[]        @relation("StudyPlanCreatedBy")
  updatedStudyPlans   StudyPlan[]        @relation("StudyPlanUpdatedBy")
  createdStudyDays    StudyDay[]         @relation("StudyDayCreatedBy")
  updatedStudyDays    StudyDay[]         @relation("StudyDayUpdatedBy")
  createdStudyTasks   StudyTask[]        @relation("StudyTaskCreatedBy")
  updatedStudyTasks   StudyTask[]        @relation("StudyTaskUpdatedBy")

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy String?
  updatedBy String?

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser   User?  @relation("AccountCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?  @relation("AccountUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([expiresAt, usedAt])
}

model Syllabus {
  id                String          @id @default(uuid())
  title             String
  rawText           String?
  processingStatus  ProcessingStatus @default(UPLOADED)
  errorMessage      String?
  failedStep        String?
  filePath          String
  fileName          String?
  fileSize          Int?
  mimeType          String?
  uploadedAt        DateTime?
  pageCount         Int?
  userId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  createdBy String?
  updatedBy String?

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("SyllabusCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?  @relation("SyllabusUpdatedBy", fields: [updatedBy], references: [id])

  topics  Topic[]
  quizzes Quiz[]
  studyPlans StudyPlan[]

  @@unique([userId, title])
  @@index([userId])
  @@index([deletedAt])
  @@index([processingStatus])
  @@index([userId, processingStatus])
}

model Topic {
  id                String   @id @default(uuid())
  title             String
  summary           String?
  priority          Priority
  difficulty        Difficulty
  order             Int
  estimatedMinutes  Int
  completedAt       DateTime?
  syllabusId        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  createdBy String?
  updatedBy String?

  syllabus      Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("TopicCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("TopicUpdatedBy", fields: [updatedBy], references: [id])

  questions QuizQuestion[]
  studyTasks StudyTask[]

  @@index([syllabusId])
  @@index([priority])
  @@index([syllabusId, order])
  @@index([deletedAt])
}

model Quiz {
  id            String   @id @default(uuid())
  title         String
  syllabusId    String
  questionCount Int
  timeEstimate  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  createdBy String?
  updatedBy String?

  syllabus      Syllabus       @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("QuizCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("QuizUpdatedBy", fields: [updatedBy], references: [id])
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([syllabusId])
  @@index([deletedAt])
}

model QuizQuestion {
  id               String     @id @default(uuid())
  quizId           String
  topicId          String?
  questionText     String
  options          Json
  explanation      String
  difficulty       Difficulty
  estimatedSeconds Int
  order            Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  createdBy String?
  updatedBy String?

  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic         Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdByUser User?  @relation("QuizQuestionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?  @relation("QuizQuestionUpdatedBy", fields: [updatedBy], references: [id])

  @@index([quizId])
  @@index([topicId])
  @@index([quizId, order])
  @@index([deletedAt])
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  quizId        String
  score         Int
  totalQuestions Int
  answers       Json?
  timeTaken     Int?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  createdBy String?
  updatedBy String?

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("QuizAttemptCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?  @relation("QuizAttemptUpdatedBy", fields: [updatedBy], references: [id])

  @@index([userId, createdAt])
  @@index([quizId])
  @@index([deletedAt])
}

model StudyPlan {
  id            String     @id @default(uuid())
  syllabusId    String
  userId        String
  dailyMinutes  Int        @default(120)
  preferredDays Json?
  targetDate    DateTime?
  startDate     DateTime   @default(now())
  totalDays     Int
  bufferDays    Int        @default(0)
  status        PlanStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  createdBy String?
  updatedBy String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabus  Syllabus   @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("StudyPlanCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?  @relation("StudyPlanUpdatedBy", fields: [updatedBy], references: [id])
  days      StudyDay[]

  @@index([userId])
  @@index([syllabusId])
  @@index([syllabusId, status])
  @@index([status])
}

model StudyDay {
  id           String   @id @default(uuid())
  studyPlanId  String
  date         DateTime
  dayNumber    Int
  totalMinutes Int
  isComplete   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy String?
  updatedBy String?

  plan  StudyPlan   @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("StudyDayCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("StudyDayUpdatedBy", fields: [updatedBy], references: [id])
  tasks StudyTask[]

  @@unique([studyPlanId, date])
  @@index([studyPlanId])
  @@index([date])
  @@index([studyPlanId, date])
}

model StudyTask {
  id          String    @id @default(uuid())
  studyDayId  String
  topicId     String
  minutes     Int
  order       Int
  isComplete  Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy String?
  updatedBy String?

  day   StudyDay @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  topic Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("StudyTaskCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("StudyTaskUpdatedBy", fields: [updatedBy], references: [id])

  @@index([studyDayId])
  @@index([topicId])
  @@index([studyDayId, order])
}
